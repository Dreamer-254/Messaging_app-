<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>FAQ – LinkSphere</title>
<style>
    body {
  margin: 0;
  font-family: "Poppins", sans-serif;
  background: #f5f3f0;
}

/* NAVBAR */
.navbar {
  width: 100%;
  background: #075e54;
  color: #fff;
  padding: 15px 25px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.navbar a {
  color: #fff;
  margin-left: 20px;
  text-decoration: none;
  font-size: 15px;
}

.navbar a.active {
  font-weight: bold;
  text-decoration: underline;
}

.logo {
  height: 35px;
  margin-right: 10px;
}

.left {
  display: flex;
  align-items: center;
}

.container {
  width: 70%;
  margin: 40px auto;
}

h1 {
  font-size: 35px;
  color: #075e54;
  text-align: center;
}

.subtitle {
  text-align: center;
  color: #333;
  margin-bottom: 30px;
}

/* FAQ BOX */
.faq-box {
  background: #fff;
  padding: 20px;
  border-radius: 14px;
  box-shadow: 0 2px 10px rgba(0,0,0,.1);
}

.faq {
  margin-bottom: 10px;
}

.faq-btn {
  width: 100%;
  padding: 15px;
  background: #e8f5f3;
  border: none;
  text-align: left;
  border-radius: 8px;
  font-size: 16px;
  cursor: pointer;
  transition: .3s;
}

.faq-btn:hover {
  background: #d3eeeb;
}

.faq-btn.active {
  background: #c7e9e6;
}

.faq-content {
  overflow: hidden;
  max-height: 0;
  transition: max-height .3s ease;
  background: white;
  padding: 0 10px;
  border-left: 3px solid #075e54;
  margin-top: 5px;
}

.faq-content p {
  padding: 10px 5px;
  color: #333;
}

</style>
</head>

<body>

<div class="navbar">
  <div class="left">
    <img src="/linksphere.jpg" class="logo">
    <span class="app-name">LinkSphere</span>
  </div>
  <div class="right">
    <a href="/chat">Chats</a>
    <a href="/groups">Groups</a>
    <a href="/status">Status</a>
    <a href="/help">Help</a>
    <a href="/faq" class="active">FAQ</a>
  </div>
</div>

<div class="container">
  <h1>Frequently Asked Questions</h1>
  <p class="subtitle">Find answers to common questions about LinkSphere</p>

  <div class="faq-box">

    <div class="faq">
      <button class="faq-btn">What is LinkSphere?</button>
      <div class="faq-content">
        <p>LinkSphere is a real-time messaging platform where users can chat, create groups, share media, and stay connected.</p>
      </div>
    </div>

    <div class="faq">
      <button class="faq-btn">Is my chat data secure?</button>
      <div class="faq-content">
        <p>Yes. All messages are transferred securely. You can also enable end-to-end encryption in settings (optional).</p>
      </div>
    </div>

    <div class="faq">
      <button class="faq-btn">How do I create a group?</button>
      <div class="faq-content">
        <p>Go to the Groups tab, click “Create Group”, choose members, and start chatting.</p>
      </div>
    </div>

    <div class="faq">
      <button class="faq-btn">How do I change my profile info?</button>
      <div class="faq-content">
        <p>Open your Profile page → Edit profile → Save changes.</p>
      </div>
    </div>

    <div class="faq">
      <button class="faq-btn">Can I delete my account?</button>
      <div class="faq-content">
        <p>Yes. Go to Settings → Account → Delete Account.</p>
      </div>
    </div>

  </div>
</div>

<script>
  const buttons = document.querySelectorAll(".faq-btn");

  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      btn.classList.toggle("active");
      const content = btn.nextElementSibling;

      if (content.style.maxHeight) {
        content.style.maxHeight = null;
      } else {
        content.style.maxHeight = content.scrollHeight + "px";
      }
    });
  });
</script>

</body>
</html>
