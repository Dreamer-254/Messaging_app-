<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LinkSphere | Welcome</title>

  <style>
    body {
      margin: 0;
      padding: 0;
      height: 100vh;
      background: linear-gradient(135deg, #4facfe, #00f2fe);
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: "Poppins", sans-serif;
    }

    .container {
      background: #fff;
      width: 430px;
      padding: 2.5rem;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 5px 25px rgba(0, 0, 0, 0.15);
      animation: fadeIn 0.6s ease-in-out;
    }

    .logo {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 15px;
    }

    h1 {
      font-size: 28px;
      margin-bottom: 10px;
      color: #333;
      font-weight: 700;
    }

    p {
      color: #555;
      font-size: 14.5px;
      margin-bottom: 25px;
    }

    .btn {
      display: block;
      width: 85%;
      padding: 12px;
      margin: 10px auto;
      background: #00aaff;
      color: #fff;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
      transition: 0.3s;
    }

    .btn:hover {
      background: #0088cc;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body>

  <div class="container">
    <img src="/default-avatar.png" class="logo" alt="Logo" />

    <h1>Welcome to LinkSphere</h1>

    <p>Your company’s internal communication system.  
       Connect, chat, and collaborate easily.</p>

    <a href="/login" class="btn">Login</a>
    <a href="/register" class="btn">Create Account</a>
  </div>

</body>
</html>
