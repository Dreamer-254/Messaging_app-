<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Notifications – LinkSphere</title>
<style>
body {
  margin: 0;
  font-family: "Poppins", sans-serif;
  background: #f5f3f0;
}
/* NAVBAR */
.navbar {
  width: 100%;
  background: #075e54;
  color: #fff;
  padding: 15px 25px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.navbar a {
  color: #fff;
  margin-left: 20px;
  text-decoration: none;
  font-size: 15px;
}
.navbar a.active {
  font-weight: bold;
  text-decoration: underline;
}
.logo {
  height: 35px;
  margin-right: 10px;
}
.left {
  display: flex;
  align-items: center;
}
.container {
  width: 70%;
  margin: 40px auto;
}
h1 {
  font-size: 35px;
  color: #075e54;
  text-align: center;
}
.subtitle {
  text-align: center;
  color: #333;
  margin-bottom: 30px;
}
.notify-box {
  background: #fff;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0,0,0,.1);
  padding: 20px;
}
.notify-item {
  display: flex;
  align-items: center;
  border-bottom: 1px solid #eee;
  padding: 15px 0;
}
.notify-item:last-child {
  border-bottom: none;
}
.icon {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: #ccc;
  margin-right: 20px;
}
.icon.green {
  background: #4caf50;
}
.icon.red {
  background: #f44336;
}
.icon.blue {
  background: #2196f3;
}
.text h3 {
  margin: 0;
  color: #075e54;
}
.text p {
  margin: 5px 0;
  color: #555;
}
.time {
  font-size: 12px;
  color: #999;
}

</style>
</head>

<body>

<!-- NAVBAR -->
<div class="navbar">
  <div class="left">
    <img src="/linksphere.jpg" class="logo">
    <span class="app-name">LinkSphere</span>
  </div>
  <div class="right">
    <a href="/chat">Chats</a>
    <a href="/groups">Groups</a>
    <a href="/status">Status</a>
    <a href="/notifications" class="active">Notifications</a>
    <a href="/faq">FAQ</a>
  </div>
</div>

<!-- MAIN -->
<div class="container">
  <h1>Notifications</h1>
  <p class="subtitle">Your recent alerts and system messages</p>

  <div class="notify-box">

    <!-- Notification 1 -->
    <div class="notify-item">
      <div class="icon"></div>
      <div class="text">
        <h3>New Message</h3>
        <p>You have unread messages in your chats.</p>
        <span class="time">Just now</span>
      </div>
    </div>

    <!-- Notification 2 -->
    <div class="notify-item">
      <div class="icon green"></div>
      <div class="text">
        <h3>Group Update</h3>
        <p>Someone added you to a new group.</p>
        <span class="time">8 minutes ago</span>
      </div>
    </div>

    <!-- Notification 3 -->
    <div class="notify-item">
      <div class="icon red"></div>
      <div class="text">
        <h3>Security Alert</h3>
        <p>A new device logged into your account.</p>
        <span class="time">1 hour ago</span>
      </div>
    </div>

    <!-- Notification 4 -->
    <div class="notify-item">
      <div class="icon blue"></div>
      <div class="text">
        <h3>Profile Updated</h3>
        <p>Your profile information was successfully changed.</p>
        <span class="time">Yesterday</span>
      </div>
    </div>

  </div>
</div>

</body>
</html>
