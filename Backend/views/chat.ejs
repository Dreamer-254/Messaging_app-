<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>LinkSphere Chat</title>
  <script src="/socket.io/socket.io.js"></script>
  <link rel="stylesheet" href="/css/chats.css">
</head>

<body>

<!-- TOP NAVIGATION BAR -->
<nav class="top-nav">
  <div class="nav-left">
    <img src="/linksphere.jpg" class="system-logo" alt="Logo">
    <div class="system-name">LinkSphere</div>
  </div>

    <div class="nav-center">
        <div class="nav-item active" onclick="switchTab('chats', this)">Chats</div>
        <div class="nav-item" onclick="switchTab('groups', this)">Groups</div>
        <div class="nav-item" onclick="switchTab('status', this)">Status</div>
    </div>

    <!-- Search Bar -->
    <input type="text" class="search-bar" placeholder="Search...">

  <div class="nav-right">
    <img src="<%= user.profile_pic_url || '/default-avatar.png' %>"
         class="nav-profile"
         onclick="toggleDropdown()">

    <div class="dropdown">
        <div class="dropdown-content" id="dropdownMenu">
    <a href="/profile">👤 Profile</a>
    <a href="/faq">❓ FAQ</a>
    <a href="/notifications">🔔 Notifications</a>
    <a href="/help">🆘 Help</a>
    <a href="/feedback">📝 Feedback</a>
    <% if (["Admin", "HR"].includes(user.role)) { %>
    <a href="/feedback-inbox">📬 Feedback Inbox</a>
    <% } %>
    <% if (user.role === "Admin") { %>
    <a href="/admin/users">👮 Admin Panel</a>
    <% } %>
    <a href="/logout" class="logout">🚪 Logout</a>
</div>

    </div>
    </div>

  </nav>



<!-- ✅ status -->
<div id="statusContainer" style="
    display:none; 
    width:73%; 
    margin-top:55px; 
    background:#efeae2; 
    padding:20px; 
    overflow-y:auto;">
    
    <h2>Your Status</h2>

    <button onclick="openCreateStatus()" 
      style="padding:8px 15px; background:#00aaff; color:white; border:none; border-radius:8px;">
      + Add Status
    </button>

    <div id="myStatus" style="margin-top:15px;"></div>

    <hr style="margin:20px 0;">

    <h3>Recent Updates</h3>
    <div id="otherStatuses"></div>
</div>

<div class="sidebar">
  <div id="chatList" class="chat-list"></div>
</div>

<!-- ✅ Chat Area -->
<div class="chat-area">
  <div class="chat-header">
  <img id="chatPic" src="/default-avatar.png">

  <div style="display:flex; flex-direction:column; flex-grow:1;">
    <span id="chatName" style="font-weight:600; font-size:16px;"></span>
    <span id="groupMembers" style="font-size:12px; color:#666;"></span>
  </div>

  <!-- Three dots menu for groups -->
  <div onclick="toggleGroupInfo()" 
     style="margin-left:auto; cursor:pointer; font-size:22px; padding:5px;">
  ⋮
</div>

<div id="groupActions" style="margin-left:10px; display:none;"> 
  <button onclick="openAddMemberPopup()" class="group-btn">Add</button> 
  <button onclick="openRemoveMemberPopup()" class="group-btn remove">Remove</button> 
</div> 
</div>


  <div id="messages"></div>

 <div class="input-area" style="display:flex; align-items:center; gap:5px;">
  <input id="input" placeholder="Type a message..." style="flex-grow:1; padding:8px; border-radius:6px;">
  
  <!-- File Upload -->
  <form id="fileUploadForm" action="/upload" method="POST" enctype="multipart/form-data" style="margin:0;">
    <label for="fileInput" style="cursor:pointer; font-size:20px;">📎</label>
    <input type="file" name="file" id="fileInput" style="display:none;" onchange="document.getElementById('fileUploadForm').submit();">
  </form>

  <button onclick="sendMessage()">Send</button>
</div>


</div>

<!-- ✅ Floating Button -->
<div class="floating-btn" onclick="togglePopup()">+</div>

<!-- ✅ Employee Popup -->
<div class="popup" id="popup">
  <h4>Select User</h4>

  <% employees.forEach(emp => { %>
    <div class="employee-item" onclick="startChat(<%= emp.id %>, '<%= emp.username %>', '<%= emp.profile_pic_url || '/default-avatar.png' %>')">
      <img src="<%= emp.profile_pic_url || '/default-avatar.png' %>">
      <span><%= emp.username %></span>
    </div>
  <% }) %>
</div>

<!-- ✅ Create Group Popup -->
<div id="createGroupPopup"
  style="display:none; position:absolute; top:20%; left:40%; background:white; 
         width:300px; padding:20px; border-radius:12px; box-shadow:0 5px 20px rgba(0,0,0,0.3);">

  <h3>Create New Group</h3>

  <input id="groupName" placeholder="Enter group name"
         style="width:90%; padding:10px; margin-bottom:10px;">

  <button onclick="createGroup()"
          style="padding:10px 15px; background:#00aaff; color:white; border:none; border-radius:6px;">
    Create
  </button>

  <button onclick="closeCreateGroup()"
          style="padding:10px 15px; margin-left:5px; background:#ccc; border:none; border-radius:6px;">
    Cancel
  </button>
</div>
<div id="groupInfoPanel"
  style="
    position:absolute;
    top:55px;
    right:-400px;
    width:350px;
    height:calc(80% - 50px);
    background:white;
    box-shadow:-5px 0 15px rgba(0,0,0,0.2);
    padding:20px;
    transition:0.3s;
    overflow-y:auto;
    z-index:10;
  ">
  
  <h2 id="infoGroupName"></h2>
  
  <img src="/default-avatar.png" id="infoGroupPic"
       style="width:90px; height:90px; border-radius:50%; display:block; margin:auto;">

  <h3 style="margin-top:25px;">Members</h3>
  <div id="infoMembers"></div>

  <!-- Admin controls -->
  <div id="infoActions" style="margin-top:20px; display:none;">
    <button onclick="openAddMemberPopup()" class="group-btn" style="width:100%; margin-bottom:10px;">
      Add Member
    </button>
    <button onclick="openRemoveMemberPopup()" class="group-btn remove" style="width:100%;">
      Remove Member
    </button>
    <button onclick="toggleGroupInfo()" style="margin-top:10px;">Close</button>
  </div>

</div>

<!-- ✅ Add Member Popup -->
<div id="addMemberPopup" class="popup-center">
  <h4>Add Member to Group</h4>
  <% employees.forEach(emp => { %>
    <div class="employee-item" onclick="addMemberToGroup(<%= emp.id %>)">
      <img src="<%= emp.profile_pic_url || '/default-avatar.png' %>">
      <span><%= emp.username %></span>
    </div>
  <% }) %>
  <button onclick="closeAddMemberPopup()" style="margin-top:10px;">Close</button>
</div>

<!-- ✅ Remove Member Popup -->
<div id="removeMemberPopup" class="popup-center">
  <h4>Remove Member from Group</h4>
  <div id="removeList"></div>
  <button onclick="closeRemoveMemberPopup()" style="margin-top:10px;">Close</button>
</div>

<!-- ✅ create-status Popup -->
<div id="createStatusPopup"
  style="display:none; position:absolute; top:20%; left:40%; background:white; width:300px; 
  padding:20px; border-radius:12px; box-shadow:0 5px 20px rgba(0,0,0,0.3);">

  <h3>Post a Status</h3>

  <textarea id="statusText" placeholder="What's going on?" 
    style="width:100%; height:80px; padding:10px; border-radius:6px; margin-bottom:10px;"></textarea>

  <input type="file" id="statusMedia" accept="image/*,video/*" style="margin-bottom:10px;">

  <button onclick="createStatus()" 
    style="padding:8px 15px; background:#00aaff; color:white; border:none; border-radius:6px;">
    Post
  </button>

  <button onclick="closeCreateStatus()" 
    style="padding:8px 15px; background:#ccc; color:black; border:none; border-radius:6px;">
    Cancel
  </button>
</div>


<script>
  const GROUPS = <%- JSON.stringify(groups) %>;

</script>

<script>
  const socket = io();
  const messages = document.getElementById("messages");
  let currentReceiver = null;

  socket.emit("user_online", <%= user.id %>);

  function togglePopup() {
    const popup = document.getElementById("popup");
    popup.style.display = popup.style.display === "block" ? "none" : "block";
  }

  function switchTab(tab, el) {
    document.querySelectorAll(".nav-item").forEach(i => i.classList.remove("active"));
    el.classList.add("active");

   if (tab === "status") {
  document.querySelector(".chat-area").style.display = "none";
  document.getElementById("statusContainer").style.display = "block";
  loadStatuses();
  return;
}

document.getElementById("statusContainer").style.display = "none";
document.querySelector(".chat-area").style.display = "flex";


   if (tab === "chats") {
  currentGroup = null;          // 🔥 FIX
  document.getElementById("chatList").innerHTML = "";
  loadChats();                  // 🔥 FIX (prep for chat list)
}


    else if (tab === "groups") {
      let html = "";

      if (["Admin", "Manager", "IT Support"].includes("<%= user.role %>")) {
        html += `
          <button onclick="openCreateGroup()"
            style="width:90%; padding:10px; margin:10px; background:#00aaff; 
                   color:white; border:none; border-radius:8px;">
            + Create Group
          </button>
        `;
      }

      GROUPS.forEach(g => {
        html += `
          <div class="chat-item" onclick="openGroup(${g.id})">
            <img src="/default-avatar.png">
            <span>${g.group_name}</span>
          </div>
        `;
      });

      document.getElementById("chatList").innerHTML = html;
    }
  }
  let currentGroup = null;      // 


  function startChat(id, name, pic) {
    currentReceiver = id;
      loadChats();   // refresh the sidebar so this chat appears

    document.getElementById("chatName").innerText = name;
    document.getElementById("chatPic").src = pic;
    document.getElementById("popup").style.display = "none";

    fetch(`/messages/${<%= user.id %>}/${id}`)
      .then(res => res.json())
      .then(history => {
        messages.innerHTML = "";

        history.forEach(msg => {
          const bubble = document.createElement("div");
          bubble.classList.add("message");
          bubble.classList.add(msg.sender_id == <%= user.id %> ? "sent" : "received");

          let ticks = "";
          if (msg.sender_id == <%= user.id %>) {
            if (msg.is_seen == 1) ticks = " ✓✓";
            else if (msg.is_delivered == 1) ticks = " ✓";
          }

          bubble.textContent = msg.message + ticks;
          messages.appendChild(bubble);
        });

        messages.scrollTop = messages.scrollHeight;

        socket.emit("mark_seen", {
          sender: id,
          receiver: <%= user.id %>
        });
      });

  }

 function sendMessage() {
  const input = document.getElementById("input");
  if (!input.value.trim()) return;

  // ✅ SEND TO GROUP
  if (currentGroup) {
    socket.emit("group message", {
      sender: <%= user.id %>,
      group_id: currentGroup,
      message: input.value
    });
  }

  // ✅ SEND TO USER
  else if (currentReceiver) {
    socket.emit("chat message", {
      sender: <%= user.id %>,
      receiver: currentReceiver,
      message: input.value
    });
  }

  input.value = "";
}


  socket.on("chat message", data => {
    if (
      (data.sender == currentReceiver && data.receiver == <%= user.id %>) ||
      (data.sender == <%= user.id %> && data.receiver == currentReceiver)
    ) {
      const bubble = document.createElement("div");
      bubble.classList.add("message");
      bubble.classList.add(data.sender == <%= user.id %> ? "sent" : "received");

      let ticks = "";
      if (data.sender == <%= user.id %>) ticks = " ✓";

      bubble.textContent = data.message + ticks;
      messages.appendChild(bubble);
      messages.scrollTop = messages.scrollHeight;
    }
  });

  socket.on("group message", data => {
  if (data.group_id === currentGroup) {
    const bubble = document.createElement("div");
    bubble.classList.add("message");
    bubble.classList.add(data.sender == <%= user.id %> ? "sent" : "received");

    bubble.textContent = data.message;
    messages.appendChild(bubble);
    messages.scrollTop = messages.scrollHeight;
  }
});


  socket.on("messages_seen", ({ receiver }) => {
    if (receiver == currentReceiver) {
      document.querySelectorAll(".sent").forEach(bubble => {
        if (!bubble.textContent.includes("✓✓")) {
          bubble.textContent = bubble.textContent.replace("✓", "✓✓");
        }
      });
    }
  });

  socket.on("messages_delivered", () => {
  document.querySelectorAll(".sent").forEach(b => {
    if (!b.textContent.includes("✓"))
      b.textContent += " ✓";
  });
});


  socket.on("online_users", users => {
    console.log("Online:", users);
  });

  function openCreateGroup() {
    document.getElementById("createGroupPopup").style.display = "block";
  }

  function closeCreateGroup() {
    document.getElementById("createGroupPopup").style.display = "none";
  }

  function createGroup() {
  const name = document.getElementById("groupName").value.trim();
  if (!name) return alert("Enter group name");

  fetch("/create-group", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      group_name: name,
      created_by: <%= user.id %>
    })
  })
  .then(res => res.text())
  .then(msg => {
    alert(msg);
    closeCreateGroup();

    // ✅ Reload page to get new groups
    location.reload();
  });
}


function openGroup(groupId) {
  currentGroup = groupId;
  currentReceiver = null;

  const group = GROUPS.find(g => g.id === groupId);

  document.getElementById("chatName").innerText = group.group_name;
  document.getElementById("chatPic").src = "/default-avatar.png";
  document.getElementById("popup").style.display = "none";

  // Show/hide admin controls
  if (["Admin", "HR"].includes("<%= user.role %>")) {
    document.getElementById("groupActions").style.display = "block";
  } else {
    document.getElementById("groupActions").style.display = "none";
  }

  // Load group members
  fetch(`/group-members/${groupId}`)
    .then(res => res.json())
    .then(members => {
      let memberNames = members.map(m => m.username).join(", ");
      document.getElementById("groupMembers").innerText = memberNames;
    });

  // Load messages
  fetch(`/group-messages/${groupId}`)
    .then(res => res.json())
    .then(history => {
      messages.innerHTML = "";

      history.forEach(msg => {
        const bubble = document.createElement("div");
        bubble.classList.add("message");
        bubble.classList.add(msg.sender_id == <%= user.id %> ? "sent" : "received");

        bubble.textContent = msg.message;
        messages.appendChild(bubble);
      });

      messages.scrollTop = messages.scrollHeight;
    });
}

function loadGroupInfo() {
  const group = GROUPS.find(g => g.id === currentGroup);
  document.getElementById("infoGroupName").innerText = group.group_name;
  document.getElementById("infoGroupPic").src = "/default-avatar.png";

  // Show admin buttons only for admin roles
if (currentGroup && ["Admin", "HR"].includes("<%= user.role %>")) {
    document.getElementById("groupActions").style.display = "block";
} else {
    document.getElementById("groupActions").style.display = "none";
}



  fetch(`/group-members/${currentGroup}`)
    .then(res => res.json())
    .then(members => {
      let html = "";
      members.forEach(m => {
        const role =
          ["Admin", "Manager", "IT Support"].includes(m.role)
            ? "(Admin)"
            : "(Member)";

        html += `
          <div class="info-member">
            <img src="${m.profile_pic_url || '/default-avatar.png'}">
            <span>${m.username}</span>
            <span class="member-role">${role}</span>
          </div>
        `;
      });

      document.getElementById("infoMembers").innerHTML = html;
    });
}


function openAddMemberPopup() {
  document.getElementById("addMemberPopup").style.display = "block";
}

function closeAddMemberPopup() {
  document.getElementById("addMemberPopup").style.display = "none";
}

function addMemberToGroup(userId) {
  fetch("/add-group-member", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      group_id: currentGroup,
      user_id: userId,
      added_by: <%= user.id %>
    })
  })
  .then(res => res.text())
  .then(msg => {
    alert(msg);
    closeAddMemberPopup();
    openGroup(currentGroup); // reload group members
  });
}



function openRemoveMemberPopup() {
  const list = document.getElementById("removeList");
  list.innerHTML = "";   // FIX added

  fetch(`/group-members/${currentGroup}`)
    .then(res => res.json())
    .then(members => {
      list.innerHTML = members.map(m =>
        `<div class="employee-item" onclick="removeMemberFromGroup(${m.id})">
          <img src="${m.profile_pic_url || '/default-avatar.png'}">
          <span>${m.username}</span>
        </div>`
      ).join("");
      document.getElementById("removeMemberPopup").style.display = "block";
    });
}


function closeRemoveMemberPopup() {
  document.getElementById("removeMemberPopup").style.display = "none";
}

function removeMemberFromGroup(userId) {
  fetch("/remove-group-member", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      group_id: currentGroup,
      user_id: userId,
      removed_by: <%= user.id %>
    })
  })
  .then(res => res.text())
  .then(msg => {
    alert(msg);
    closeRemoveMemberPopup();
    openGroup(currentGroup); // reload members
  });
}

function toggleGroupInfo() {
  const panel = document.getElementById("groupInfoPanel");
  if (panel.style.right === "0px") {
    panel.style.right = "-400px";
  } else {
    panel.style.right = "0px";
    loadGroupInfo();

    // 🔥 FIX: show admin buttons
  document.getElementById("infoActions").style.display =
  ["Admin", "HR"].includes("<%= user.role %>")
  ? "block"
  : "none";
  }
}

function refreshGroups() {
  fetch("/groups")
    .then(res => res.json())
    .then(list => {
      GROUPS.length = 0;
      list.forEach(g => GROUPS.push(g));
      switchTab("groups", document.querySelector('[onclick="switchTab(\'groups\', this)"]'));
    });
}

function loadChats() {
  fetch("/chat-list/<%= user.id %>")
    .then(res => {
      if (!res.ok) throw new Error("Failed to load chats");
      return res.json();
    })
    .then(list => {
      const container = document.getElementById("chatList");
      container.innerHTML = "";

      list.forEach(c => {
        const item = document.createElement("div");
        item.className = "chat-item";
        item.addEventListener("click", () => startChat(c.id, c.username, c.profile_pic_url || '/default-avatar.png'));

        const img = document.createElement("img");
        img.src = c.profile_pic_url || '/default-avatar.png';
        img.alt = c.username || "user";

        const span = document.createElement("span");
        span.textContent = c.username || "Unknown";

        item.appendChild(img);
        item.appendChild(span);
        container.appendChild(item);
      });
    })
    .catch(err => {
      console.error("loadChats error:", err);
      // optional: show fallback (all employees) or a message
    });
}

function openCreateStatus() {
  document.getElementById("createStatusPopup").style.display = "block";
}

function closeCreateStatus() {
  document.getElementById("createStatusPopup").style.display = "none";
}

function createStatus() {
  const text = document.getElementById("statusText").value.trim();
  const media = document.getElementById("statusMedia").files[0];

  const formData = new FormData();
  formData.append("user_id", <%= user.id %>);
  formData.append("text", text);
  if (media) formData.append("media", media);

  fetch("/create-status", {
    method: "POST",
    body: formData
  })
  .then(res => res.text())
  .then(msg => {
    alert(msg);
    closeCreateStatus();
    loadStatuses();
  });
}

function loadStatuses() {
  fetch("/statuses")
    .then(res => res.json())
    .then(all => {
      
      const my = document.getElementById("myStatus");
      const others = document.getElementById("otherStatuses");

      my.innerHTML = "";
      others.innerHTML = "";

      // My status
      const mine = all.filter(s => s.user_id == <%= user.id %>);
      mine.forEach(s => {
        my.innerHTML += renderStatus(s);
      });

      // Other users
      const rest = all.filter(s => s.user_id != <%= user.id %>);
      rest.forEach(s => {
        others.innerHTML += renderStatus(s);
      });
    });
}

function renderStatus(s) {
  let mediaHTML = "";
  if (s.media_url) {
    if (s.media_url.endsWith(".mp4")) {
      mediaHTML = `<video src="${s.media_url}" controls style="width:100%; border-radius:8px;"></video>`;
    } else {
      mediaHTML = `<img src="${s.media_url}" style="width:100%; border-radius:8px;">`;
    }
  }

  return `
    <div style="background:white; padding:15px; border-radius:10px; margin-bottom:15px;">
      <strong>${s.username}</strong>
      <p>${s.text}</p>
      ${mediaHTML}
      <span style="font-size:12px; color:#777;">${new Date(s.created_at).toLocaleString()}</span>
    </div>
  `;
}

document.querySelector(".search-bar").addEventListener("input", function() {
  let search = this.value.toLowerCase();
  document.querySelectorAll(".chat-item").forEach(item => {
    item.style.display = item.innerText.toLowerCase().includes(search)
      ? "flex" : "none";
  });
});



</script>
<script>
function toggleDropdown() {
    const menu = document.getElementById("dropdownMenu");
    menu.style.display = (menu.style.display === "block") ? "none" : "block";
}

// Close dropdown if clicking outside
document.addEventListener("click", function(event) {
    const profile = document.querySelector(".nav-profile");
    const menu = document.getElementById("dropdownMenu");

    if (!profile.contains(event.target) && !menu.contains(event.target)) {
        menu.style.display = "none";
    }
});
</script>
<script>
function uploadFile() {
  const fileInput = document.getElementById("fileInput");
  const formData = new FormData();
  formData.append("file", fileInput.files[0]);

  fetch("/upload", {
    method: "POST",
    body: formData
  })
  .then(res => res.json())
  .then(data => {
    console.log("File uploaded:", data);

    // Display file in chat
    const messagesDiv = document.getElementById("messages");
    let fileHTML = "";
    if (data.filename.match(/\.(jpg|jpeg|png|gif)$/i)) {
      // Image preview
      fileHTML = `<div class="chat-message"><img src="${data.url}" style="max-width:200px; border-radius:6px;"></div>`;
    } else {
      // Download link for docs
      fileHTML = `<div class="chat-message"><a href="${data.url}" target="_blank">${data.originalname}</a></div>`;
    }
    messagesDiv.innerHTML += fileHTML;

    // Reset file input
    fileInput.value = "";
  })
  .catch(err => console.error(err));
}
</script>

</body>
</html>
