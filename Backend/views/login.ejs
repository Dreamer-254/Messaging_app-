<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login | LinkSphere</title>

  <style>
    body {
      font-family: "Poppins", sans-serif;
      background: linear-gradient(135deg, #4facfe, #00f2fe);
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .login-container {
      background: #fff;
      width: 380px;
      padding: 2rem;
      border-radius: 18px;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0,0,0,0.15);
      animation: fadeIn 0.6s ease-in-out;
    }

    .logo {
      width: 85px;
      height: 85px;
      border-radius: 50%;
      object-fit: cover;
      margin: 0 auto 15px auto;
    }

    h2 {
      margin-bottom: 1rem;
      color: #333;
      font-weight: 600;
    }

    input {
      width: 90%;
      padding: 12px;
      margin: 10px 0;
      border: 1px solid #ddd;
      border-radius: 9px;
      font-size: 15px;
      outline: none;
    }

    button {
      width: 95%;
      padding: 12px;
      background: #00aaff;
      color: #fff;
      border: none;
      border-radius: 9px;
      font-size: 16px;
      cursor: pointer;
      margin-top: 10px;
      transition: 0.3s;
    }

    button:hover {
      background: #0088cc;
    }

    .error {
      color: red;
      font-size: 14px;
      margin-bottom: 10px;
    }

    p {
      margin-top: 15px;
      font-size: 14px;
    }

    a {
      color: #007acc;
      text-decoration: none;
      font-weight: 500;
    }

    a:hover {
      text-decoration: underline;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body>

  <div class="login-container">

    <img src="/linksphere.jpg" class="logo" alt="logo">

    <h2>Welcome Back</h2>

    <% if (errors && errors.length) { %>
      <% errors.forEach(error => { %>
        <p class="error"><%= error %></p>
      <% }) %>
    <% } %>

    <form method="POST" action="/login">
      <input 
        type="text" 
        name="employee_number" 
        placeholder="Employee Number (e.g., EMP001)" 
        required 
      />

      <input 
        type="password" 
        name="password" 
        placeholder="Password" 
        required 
      />

      <button type="submit">Login</button>
    </form>

    <p>Don’t have an account? 
      <a href="/register">Create one</a>
    </p>

  </div>

</body>
</html>
